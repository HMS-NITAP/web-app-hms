# Base URL for the HMS backend API, including the API version prefix.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Set to false to show the registration coming-soon page.
VITE_IS_REGISTRATION_ON=true

# Set to true to put the registration flow in maintenance mode (shows a countdown page).
VITE_IS_MAINTENANCE_ON=false

# When registration maintenance ends. ISO 8601 with timezone offset. Defaults to tomorrow 11:00 AM IST.
VITE_MAINTENANCE_END=2026-07-19T11:00:00+05:30
